{
  "name": "avantaria-store",
  "version": "0.02.32",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @store/db db:generate",
